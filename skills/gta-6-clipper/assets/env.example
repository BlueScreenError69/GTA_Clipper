# GTA 6 Clipper configuration. Copy to .env. No secrets here.

# --- Feature flags -----------------------------------------------------
CHAT_ACTIVITY_ENABLED=false     # not implemented yet (stub)
ANALYTICS_ENABLED=false         # not implemented yet (stub)
MUSIC_CHECK_ENABLED=true
VOICEOVER_LINES_ENABLED=false

# --- Scoring -----------------------------------------------------------
# heuristic = no LLM tokens | local = Ollama, no Claude tokens | hybrid = heuristic prefilter + Claude ranks top N
SCORER_MODE=hybrid
MAX_LLM_CANDIDATES=12           # how many candidates Claude/Ollama sees per job
EXCERPT_MAX_WORDS=120           # transcript words per candidate
OLLAMA_MODEL=                   # set only when SCORER_MODE=local
OLLAMA_HOST=http://localhost:11434

# --- Transcription -----------------------------------------------------
# Pick by hardware:
#   NVIDIA GPU 8GB+      -> WHISPER_MODEL=medium  WHISPER_DEVICE=cuda  WHISPER_COMPUTE_TYPE=float16
#   CPU, 16GB RAM        -> WHISPER_MODEL=small   WHISPER_DEVICE=cpu   WHISPER_COMPUTE_TYPE=int8
#   CPU, 8GB RAM         -> WHISPER_MODEL=base    WHISPER_DEVICE=cpu   WHISPER_COMPUTE_TYPE=int8
WHISPER_MODEL=small
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8
TRANSCRIBE_LANGUAGE=auto        # e.g. en, hi
TRANSCRIBE_CHUNK_SECONDS=600

# --- Clips -------------------------------------------------------------
CLIP_MIN_SECONDS=15
CLIP_MAX_SECONDS=59
AUTO_RENDER_TOP_N=3
OUTPUT_WIDTH=1080
OUTPUT_HEIGHT=1920

# --- Storage -----------------------------------------------------------
DATA_DIR=./data
MIN_FREE_DISK_GB=10
KEEP_TEMP_FILES=false
